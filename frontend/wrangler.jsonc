// Cloudflare Workers 部署設定（取代 Zeabur Docker + nginx；Zeabur 2026-12 停運）
// 純靜態資產，不需要 Worker 程式：dist/ 直接走 Workers 靜態資產
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mini-tw-info",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // 同 nginx 的 try_files $uri $uri/ /index.html：不存在的路徑回 index.html（只用 query string，沒有前端路由）
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true }
}
