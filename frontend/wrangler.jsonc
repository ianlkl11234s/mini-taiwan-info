// Cloudflare Workers 部署設定（取代 Zeabur Docker + nginx；Zeabur 2026-12 停運）
// dist/ 走 Workers 靜態資產；超過 25MiB 的大檔由 worker/index.ts 從 R2（site-assets）提供
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mini-tw-info",
  "routes": [{ "pattern": "mini-tw-info.itsmigu.com", "custom_domain": true }],
  // 加了 routes 後一定要寫，否則 workers.dev 測試網址會整站 404
  "workers_dev": true,
  "compatibility_date": "2026-10-01",
  "main": "worker/index.ts",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    // 同 nginx 的 try_files $uri $uri/ /index.html：不存在的路徑回 index.html（只用 query string，沒有前端路由）
    "not_found_handling": "single-page-application",
    // 只有超過 25MiB 的大檔先經 Worker 從 R2 提供；其餘仍直接回靜態資產
    "run_worker_first": ["/data/forestry/forest_reserve.geojson"]
  },
  // 大檔放 R2 bucket site-assets（key：<站名>/<網站路徑>），上傳見 package.json 的 r2:upload
  "r2_buckets": [{ "binding": "BIG", "bucket_name": "site-assets" }],
  "observability": { "enabled": true }
}
