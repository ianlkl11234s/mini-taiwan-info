# Mini Taiwan Info — frontend env template
# 複製本檔到 .env.local 並填入真實值。.env.local 不會進 git。
#
# 取得位置：
#   - Supabase：gis-platform/.env 或 Supabase Dashboard
#   - Mapbox：https://account.mapbox.com/

# === Supabase（公開，會被 bundle 進 JS）===
VITE_SUPABASE_URL=https://utcmcikhvxnohbxchbrs.supabase.co
VITE_SUPABASE_ANON_KEY=

# === Mapbox（公開，會被 bundle）===
# 拍板 2026-05-14：使用 light-v11 style
# Production token 必須是 URL-restricted（限本站 referrer）
VITE_MAPBOX_TOKEN=

# === Backend wrapper（TGOS + explode engine）===
# 本機開發：http://localhost:8000
# Production：填 Zeabur URL
VITE_API_BASE_URL=http://localhost:8000

# === Analytics（選填）===
VITE_GA_ID=

# === 主題列預設值（dev 用）===
VITE_DEFAULT_THEME=home-basics
