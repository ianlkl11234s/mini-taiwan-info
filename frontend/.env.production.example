# Mini Taiwan Info — Production environment template
# 複製本檔並設定真實 production 值；在 Zeabur 環境變數面板逐項設置。
# Vite build 時會讀取這些值（VITE_ 前綴的變數會被 bundle 進最終 JS，皆為公開金鑰）。

# === Supabase（公開 anon key，會被 bundle 進 JS）===
# 來源：gis-platform Supabase Dashboard → Settings → API
# 用途：前端直連 public RLS table / RPC（anon SELECT 已開放）
VITE_SUPABASE_URL=https://utcmcikhvxnohbxchbrs.supabase.co
VITE_SUPABASE_ANON_KEY=PASTE_YOUR_SUPABASE_ANON_KEY_HERE

# === Mapbox（公開 token，會被 bundle 進 JS）===
# CRITICAL: production 必須使用 URL-restricted token（限本站 referrer），防盜用
#   1. 登入 https://account.mapbox.com/tokens/
#   2. 建立新 token：
#      - 勾選 scopes: tiles:read, styles:read, fonts:read
#      - 勾選 "Restrict to URL(s)"
#      - 輸入生產域名：https://your-production-domain.com/*
#   3. 複製 token，貼入下方 / Zeabur 變數面板
# 風格：light-v11（拍板 2026-05-14）
VITE_MAPBOX_TOKEN=PASTE_YOUR_URL_RESTRICTED_MAPBOX_TOKEN_HERE

# === Backend API Base URL ===
# 後端 wrapper（TGOS + explode engine）。前端會去尾斜線後使用。
# 本機開發：http://localhost:8000
# 生產部署：https://api.your-domain.com 或 https://<backend-service>.zeabur.app
VITE_API_BASE_URL=https://api.your-domain.com

# === Google Analytics（選填）===
# 填入 GA4 measurement ID（格式：G-XXXXXXXXXX）；不填則停用分析
VITE_GA_ID=

# === 預設主題 ===
# 用戶進站時的預設主題（允許值：home-basics / water / ...）
VITE_DEFAULT_THEME=home-basics
